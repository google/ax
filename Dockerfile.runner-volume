# The runner volume: an image that holds only the static ax-task-runner.
#
# It is never run as a container. Agent Substrate mounts it read-only into a
# task's container as an image volume, and the container runs the runner from
# there, so task images can be pure agent images without the runner baked in.
# Rolling out a new runner then means changing one digest on ax-server instead
# of rebuilding every agent image.
#
#   make images   # builds and pushes it, and records its digest
FROM scratch
ARG TARGETARCH
COPY bin/linux_${TARGETARCH:-amd64}/ax-task-runner /ax-task-runner
