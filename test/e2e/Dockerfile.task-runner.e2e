ARG BASE_IMAGE=ax-task-runner:base
FROM ${BASE_IMAGE}

# Initialize the sample Git repository used by E2E tests
RUN mkdir -p /workspace /tmp/sample-src && \
    cd /tmp/sample-src && \
    git init -b main && \
    git config user.name "AX E2E" && \
    git config user.email "e2e@ax.local" && \
    echo "# Sample E2E Repo" > README.md && \
    echo "print('hello from git repo v1')" > app.py && \
    git add README.md app.py && \
    git commit -m "Initial commit" && \
    git tag v1.0.0 && \
    echo "print('hello from git repo main')" > app.py && \
    git commit -am "Second commit on main" && \
    git clone --bare /tmp/sample-src /opt/ax-e2e-sample-repo.git && \
    rm -rf /tmp/sample-src

WORKDIR /workspace
EXPOSE 80
ENTRYPOINT ["/usr/local/bin/ax-task-runner"]
