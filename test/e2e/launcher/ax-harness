# Stand-in for a prebuilt agent image's launcher. Instead of running an agent,
# it answers with the goal and session it was handed, and counts its runs next
# to the output so tests can tell whether a resume ran it again.
set -eu
echo run >> "$(dirname "${AX_OUTPUT_FILE}")/e2e-launcher-runs"
{
  printf 'goal=%s\n' "$(cat "${AX_GOAL_FILE}")"
  printf 'session=%s\n' "$(cat "${AX_SESSION_FILE}")"
} > "${AX_OUTPUT_FILE}"
